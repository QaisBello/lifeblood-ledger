/// One row per anonymised donor (260), with the drives they attended.
table Donors

	column donor_id
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: donor_id

	column drives_attended
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: drives_attended

	column first_drive
		dataType: string
		summarizeBy: none
		sourceColumn: first_drive

	column last_drive
		dataType: string
		summarizeBy: none
		sourceColumn: last_drive

	column times_donated_with_ohls
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: times_donated_with_ohls

	partition Donors = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "dim_donor.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"donor_id", type text},
				            {"drives_attended", Int64.Type},
				            {"first_drive", type text},
				            {"last_drive", type text},
				            {"times_donated_with_ohls", Int64.Type}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

