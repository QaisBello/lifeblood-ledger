  ],
  "measures": [
    {
      "name": "Check-ins",
      "table": "Responses",
      "folder": "Drive",
      "format": "#,0",
      "dax": "COUNTROWS ( Responses )",
      "description": "Donor check-ins (form responses after de-duplication)."
    },
    {
      "name": "Units Collected",
      "table": "Responses",
      "folder": "Drive",
      "format": "#,0",
      "dax": "CALCULATE ( [Check-ins], Responses[donated] == TRUE () )",
      "description": "Units of whole blood collected."
    },
    {
      "name": "Deferrals",
      "table": "Responses",
      "folder": "Screening",
      "format": "#,0",
      "dax": "CALCULATE ( [Check-ins], Responses[donated] == FALSE () )",
      "description": "Check-ins turned away at screening (blank for the Donated reason, so bar charts leave it out)."
    },
    {
      "name": "Donation Rate",
      "table": "Responses",
      "folder": "Drive",
      "format": "0%",
      "dax": "DIVIDE ( [Units Collected], [Check-ins] )",
      "description": "Share of check-ins who donated."
    },
    {
      "name": "Deferral Rate",
      "table": "Responses",
      "folder": "Screening",
      "format": "0%",
      "dax": "DIVIDE ( [Deferrals], [Check-ins] )",
      "description": "Share of check-ins deferred."
    },
    {
      "name": "First-timer Share",
      "table": "Responses",
      "folder": "Drive",
      "format": "0%",
      "dax": "DIVIDE ( CALCULATE ( [Check-ins], Responses[first_time] == TRUE () ), [Check-ins] )",
      "description": "Share who had never donated before."
    },
    {
      "name": "Unique Donors",
      "table": "Responses",
      "folder": "Drive",
      "format": "#,0",
      "dax": "DISTINCTCOUNT ( Responses[donor_id] )",
      "description": "Distinct donors."
    },
    {
      "name": "Measurable Check-ins",
      "table": "Responses",
      "folder": "Return",
      "format": "#,0",
      "dax": "CALCULATE ( [Check-ins], Responses[has_later_drive] == TRUE () )",
      "description": "Check-ins at drives that have a later drive, so return can be measured."
    },
    {
      "name": "Promised Return %",
      "table": "Responses",
      "folder": "Return",
      "format": "0%",
      "dax": "DIVIDE (\n    CALCULATE ( [Check-ins], Responses[has_later_drive] == TRUE (), Responses[will_return] == TRUE () ),\n    [Measurable Check-ins]\n)",
      "description": "Said they would come back."
    },
    {
      "name": "Actual Return %",
      "table": "Responses",
      "folder": "Return",
      "format": "0%",
      "dax": "DIVIDE (\n    CALCULATE ( [Check-ins], Responses[has_later_drive] == TRUE (), Responses[came_back_later] == TRUE () ),\n    [Measurable Check-ins]\n)",
      "description": "Were seen at a later drive."
    },
    {
      "name": "Return Gap",
      "table": "Responses",
      "folder": "Return",
      "format": "0\" points\"",
      "dax": "( [Promised Return %] - [Actual Return %] ) * 100",
      "description": "Promise minus reality, in percentage points."
    },
    {
      "name": "Reminder Opt-in %",
      "table": "Responses",
      "folder": "Return",
      "format": "0%",
      "dax": "DIVIDE ( CALCULATE ( [Check-ins], Responses[wants_reminder] == TRUE () ), [Check-ins] )",
      "description": "Asked to be reminded about the next drive."
    },
    {
      "name": "Unknown Blood Group %",
      "table": "Responses",
      "folder": "Screening",
      "format": "0%",
      "dax": "DIVIDE ( CALCULATE ( [Check-ins], Responses[blood_group] = \"Unknown\" ), [Check-ins] )",
      "description": "Did not know their blood group."
    },
    {
      "name": "Low PCV/Hb Share of Deferrals",
      "table": "Responses",
      "folder": "Screening",
      "format": "0%",
      "dax": "DIVIDE ( CALCULATE ( [Check-ins], Responses[deferral_reason] = \"Low PCV / Haemoglobin\" ), [Deferrals] )",
      "description": "Deferrals caused by low packed cell volume or haemoglobin."
    },
    {
      "name": "Female Deferral Rate",
      "table": "Responses",
      "folder": "Screening",
      "format": "0%",
      "dax": "CALCULATE ( [Deferral Rate], REMOVEFILTERS ( Responses[gender] ), Responses[gender] = \"Female\" )",
      "description": "Ignores any gender slicer."
    },
    {
      "name": "Male Deferral Rate",
      "table": "Responses",
      "folder": "Screening",
      "format": "0%",
      "dax": "CALCULATE ( [Deferral Rate], REMOVEFILTERS ( Responses[gender] ), Responses[gender] = \"Male\" )",
      "description": "Ignores any gender slicer."
    },
    {
      "name": "Journey Headline",
      "table": "Responses",
      "folder": "Return",
      "format": "General",
      "dax": "IF (\n    ISBLANK ( [Measurable Check-ins] ),\n    \"Return can't be measured for the latest drive yet\",\n    FORMAT ( [Promised Return %], \"0%\" ) & \" promised to come back. \" & FORMAT ( [Actual Return %], \"0%\" ) & \" did.\"\n)",
      "description": "Dynamic headline for the journey."
    },
    {
      "name": "Comments",
      "table": "Responses",
      "folder": "Voice",
      "format": "#,0",
      "dax": "CALCULATE ( [Check-ins], NOT ISBLANK ( Responses[experience_text] ) )",
      "description": "Check-ins that left a written comment (blank otherwise, so the quote table lists only comments)."
    },
    {
      "name": "Journey Check-ins",
      "table": "Journey",
      "folder": "Return",
      "format": "#,0",
      "dax": "DISTINCTCOUNT ( Journey[response_id] )",
      "description": "Check-ins reaching each journey stage."
    }
  ],
